{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["metric", "limitations", "score", "categories", "scenarios"],
  "properties": {
    "metric": {"type": "string"},
    "limitations": {"type": "string"},
    "score": {
      "type": "object",
      "required": ["passing", "total", "percentage"],
      "properties": {
        "passing": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 1},
        "percentage": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "categories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["passing", "total", "percentage"],
        "properties": {
          "passing": {"type": "integer", "minimum": 0},
          "total": {"type": "integer", "minimum": 1},
          "percentage": {"type": "number", "minimum": 0, "maximum": 100}
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "category", "compatible", "differences"],
        "properties": {
          "name": {"type": "string"},
          "category": {"type": "string"},
          "compatible": {"type": "boolean"},
          "differences": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
